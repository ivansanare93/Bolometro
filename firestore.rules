rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección de usuarios
    match /users/{userId} {
      // Permitir consultas a la colección de usuarios para búsqueda por email
      // Solo queries limitadas (list) para búsquedas de 1 resultado
      allow list: if request.auth != null && 
                     request.query.limit <= 1;
      
      // El usuario puede leer su propio perfil completo
      // Otros usuarios autenticados pueden leer perfiles para buscar amigos
      allow get: if request.auth != null;
      // Solo el usuario puede escribir su propio perfil
      // Esto incluye actualizar el FCM token
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Reglas para la subcolección de sesiones
      match /sesiones/{sesionId} {
        // El propietario puede leer, escribir y eliminar sus sesiones
        // Los amigos pueden leer sesiones para comparar rankings
        allow read: if request.auth != null && 
                    (request.auth.uid == userId || 
                     exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)));
        allow write: if request.auth != null && request.auth.uid == userId;
        
        // Validaciones adicionales para escritura
        allow create: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasAll(['fecha', 'lugar', 'tipo', 'partidas'])
                      && request.resource.data.tipo in ['Entrenamiento', 'Competición'];
        
        allow update: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasAll(['fecha', 'lugar', 'tipo', 'partidas'])
                      && request.resource.data.tipo in ['Entrenamiento', 'Competición'];
      }
      
      // Reglas para la subcolección de amigos
      match /friends/{friendId} {
        // El usuario puede leer su lista de amigos
        allow read: if request.auth != null && request.auth.uid == userId;
        // Solo el usuario puede modificar su lista de amigos
        allow write: if request.auth != null && request.auth.uid == userId;
        // Permitir agregar un amigo cuando se acepta una solicitud de amistad:
        // El usuario que acepta (request.auth.uid = friendId) puede escribir 
        // en la colección de amigos del remitente (userId) si el documento 
        // que está creando corresponde al usuario autenticado
        allow create: if request.auth != null && 
                      request.auth.uid == friendId &&
                      request.resource.data.userId == request.auth.uid;
        // Permitir eliminar un amigo de forma bidireccional:
        // Un usuario puede eliminar su propia entrada (donde su userId está 
        // almacenado en el documento) de la colección de amigos de otro usuario
        allow delete: if request.auth != null && 
                      request.auth.uid == friendId &&
                      resource.data.userId == request.auth.uid;
      }
      
      // Reglas para la subcolección de solicitudes de amistad
      match /friendRequests/{requestId} {
        // El remitente o el destinatario pueden leer la solicitud
        allow read: if request.auth != null && 
                    (request.auth.uid == userId || 
                     request.auth.uid == resource.data.fromUserId);
        // Solo el remitente puede crear una solicitud
        allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.fromUserId &&
                      request.resource.data.toUserId == userId;
        // Solo el destinatario puede actualizar una solicitud (aceptar/rechazar)
        allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.toUserId == userId;
        // El remitente o destinatario pueden eliminar la solicitud
        allow delete: if request.auth != null && 
                      (request.auth.uid == userId || 
                       request.auth.uid == resource.data.fromUserId);
      }
      
      // Reglas para la subcolección de notificaciones
      match /notifications/{notificationId} {
        // Solo el propietario puede leer sus notificaciones
        allow read: if request.auth != null && request.auth.uid == userId;
        // Solo el propietario puede actualizar (marcar como leída) sus notificaciones
        allow update: if request.auth != null && request.auth.uid == userId;
        // Permitir crear notificaciones desde otros usuarios (solicitudes de amistad)
        allow create: if request.auth != null &&
                      request.resource.data.keys().hasAll(['type', 'createdAt', 'read']) &&
                      request.resource.data.type in ['friend_request', 'friend_request_accepted', 'daily_engagement'] &&
                      request.resource.data.read == false;
        // Solo el propietario puede eliminar sus notificaciones
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Reglas para actividad diaria de uso
      match /daily_engagement/{dayId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /daily_engagement_metrics/{metricId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Reglas para la subcolección de gamificación
      match /gamification/{document=**} {
        // Solo el propietario puede leer y escribir sus datos de gamificación
        // Esto incluye el documento 'progress' y la subcolección 'achievements'
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reglas para la subcolección de notas
      match /notas/{notaId} {
        // Solo el propietario puede leer y escribir su bitácora
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Arsenal privado. Preparado localmente; requiere despliegue autorizado.
      match /{arsenalCollection}/{entityId} {
        function owner() {
          return request.auth != null && request.auth.uid == userId
            && arsenalCollection in ['balls', 'ball_maintenance'];
        }
        function validPayload(p) {
          return p is map && p.id == entityId &&
            (arsenalCollection == 'balls'
              ? p.keys().hasAll(['id', 'name', 'brand', 'weightLbs', 'coverstock',
                  'finish', 'purchaseDate', 'isActive', 'notes', 'createdAt', 'updatedAt'])
                && p.keys().hasOnly(['id', 'name', 'brand', 'weightLbs', 'coverstock',
                  'finish', 'purchaseDate', 'isActive', 'notes', 'createdAt', 'updatedAt'])
                && p.name is string && p.name.size() > 0 && p.name.size() <= 500
                && p.weightLbs is number && p.weightLbs > 0 && p.weightLbs <= 20
                && p.isActive is bool && p.createdAt is string && p.updatedAt is string
                && (p.brand == null || p.brand is string)
                && (p.coverstock == null || p.coverstock is string)
                && (p.finish == null || p.finish is string)
                && (p.purchaseDate == null || p.purchaseDate is string)
                && (p.notes == null || p.notes is string)
              : p.keys().hasAll(['id', 'ballId', 'type', 'date', 'notes'])
                && p.keys().hasOnly(['id', 'ballId', 'type', 'date', 'notes'])
                && p.ballId is string && p.date is string
                && p.type in ['cleaning', 'resurfacing', 'oilExtraction', 'other']
                && (p.notes == null || p.notes is string)
                && existsAfter(/databases/$(database)/documents/users/$(userId)/balls/$(p.ballId)));
        }
        function validEnvelope(d, op) {
          return d.keys().hasOnly(['id', 'revision', 'baseRevision', 'operationId',
              'payload', 'kind', 'updatedAt'])
            && d.id == entityId && d.operationId == op
            && d.revision is int && d.revision >= 1
            && d.baseRevision is int && d.baseRevision >= 0
            && d.updatedAt == request.time && validPayload(d.payload);
        }
        function acceptedWrite() {
          let d = request.resource.data;
          let history = getAfter(/databases/$(database)/documents/users/$(userId)/$(arsenalCollection)/$(entityId)/revisions/$(d.operationId));
          return validEnvelope(d, d.operationId) && d.kind == 'accepted'
            && d.revision == d.baseRevision + 1
            && history.data == d;
        }
        allow read: if owner();
        allow create: if owner() && acceptedWrite()
          && request.resource.data.baseRevision == 0;
        allow update: if owner() && acceptedWrite()
          && request.resource.data.baseRevision == resource.data.revision;
        allow delete: if false;

        match /revisions/{operationId} {
          allow read: if owner();
          allow create: if owner() && validEnvelope(request.resource.data, operationId)
            && ((request.resource.data.kind == 'accepted'
                && getAfter(/databases/$(database)/documents/users/$(userId)/$(arsenalCollection)/$(entityId)).data == request.resource.data)
              || (request.resource.data.kind == 'conflict'
                && get(/databases/$(database)/documents/users/$(userId)/$(arsenalCollection)/$(entityId)).data.revision != request.resource.data.baseRevision
                && getAfter(/databases/$(database)/documents/users/$(userId)/$(arsenalCollection)/$(entityId)).data == get(/databases/$(database)/documents/users/$(userId)/$(arsenalCollection)/$(entityId)).data
                && request.resource.data.revision == get(/databases/$(database)/documents/users/$(userId)/$(arsenalCollection)/$(entityId)).data.revision));
          allow update, delete: if false;
        }
      }
    }
    
    // Configuración pública de la app (versión mínima, URL de actualización, etc.)
    // Lectura pública sin autenticación; escritura denegada desde el cliente.
    match /app_config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Feedback enviado desde la app (solo creación para usuarios autenticados)
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'appVersion',
                      'authEmail',
                      'createdAt',
                      'destinationEmail',
                      'languageCode',
                      'message',
                      'platform',
                      'rating',
                      'status',
                      'type',
                      'userId',
                    ])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.type in ['suggestion', 'bug', 'other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && (!('authEmail' in request.resource.data)
                        || (request.resource.data.authEmail is string
                            && request.resource.data.authEmail.size() <= 254))
                    && (!('rating' in request.resource.data)
                        || (request.resource.data.rating is int
                            && request.resource.data.rating >= 1
                            && request.resource.data.rating <= 5))
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.appVersion is string
                    && request.resource.data.appVersion.size() > 0
                    && request.resource.data.appVersion.size() <= 32
                    && request.resource.data.platform is string
                    && request.resource.data.platform.size() > 0
                    && request.resource.data.platform.size() <= 16
                    && request.resource.data.languageCode is string
                    && request.resource.data.languageCode.size() > 0
                    && request.resource.data.languageCode.size() <= 10
                    && request.resource.data.destinationEmail is string
                    && request.resource.data.destinationEmail == 'appbolometro@gmail.com'
                    && request.resource.data.status == 'new';
      allow read, update, delete: if false;
    }

    // Denegar acceso a cualquier otra ruta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
